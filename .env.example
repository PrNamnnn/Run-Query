# ==============================================================================
# Run Query — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC CONFIGURATION (Safe for browser / Vercel)
# ------------------------------------------------------------------------------
# Backend API Base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (safe for public client usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER-SIDE SECRETS (NEVER expose to frontend or client bundle)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Service Role Key (Used strictly server-side for admin tasks like account deletion)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (Optional: Used for high-speed local token validation)
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins for FastAPI (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://run-query.vercel.app
